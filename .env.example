# server/.env 和 ai_service/.env 共用以下变量，复制到对应目录并填入真实值

# 数据库
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=employment_platform

# JWT
JWT_SECRET=your_jwt_secret_here

# MiMo AI
MIMO_API_URL=https://token-plan-cn.xiaomimimo.com/anthropic/v1/messages
MIMO_API_KEY=your_mimo_api_key_here

# AI 服务地址
AI_SERVICE_URL=http://localhost:8000/api/ai/embed

# 默认管理员密码 (init-database.js 使用)
ADMIN_PASSWORD=123456
