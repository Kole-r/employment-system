          <mxGeometry x="590" y="241" width="8" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="m8" value="8. UserModel.findByUsername(username)" style="endArrow=open;endSize=9;html=1;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=none;verticalAlign=bottom;verticalLabelPosition=top;spacingTop=-4;" edge="1" parent="1">
