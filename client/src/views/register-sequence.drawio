        <!-- ═══════ 注册成功流程 ═══════ -->

        <!-- 1. 切换注册模式（自调用） -->
        <mxCell id="m1" value="1. 切换至注册模式 isRegister = true" style="endArrow=open;endSize=9;html=1;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=none;curved=0;verticalAlign=bottom;verticalLabelPosition=top;spacingTop=-4;" edge="1" parent="1">
