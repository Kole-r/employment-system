              <mxPoint x="183" y="171"/>
            </Array>
            <mxPoint x="183" y="171" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 4. POST register → Axios -->
        <mxCell id="m4" value="4. POST /webApi/user/register {username, password, real_name}" style="endArrow=open;endSize=9;html=1;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=none;verticalAlign=bottom;verticalLabelPosition=top;spacingTop=-4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
