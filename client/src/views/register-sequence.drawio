        <mxCell id="act_ax1" value="" style="fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="320" y="191" width="8" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="m5" value="5. 添加 Authorization: Bearer &lt;token&gt;" style="endArrow=open;endSize=9;html=1;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=none;verticalAlign=bottom;verticalLabelPosition=top;spacingTop=-4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="328" y="198" as="sourcePoint"/>
            <mxPoint x="456" y="198" as="targetPoint"/>
          </mxGeometry>
