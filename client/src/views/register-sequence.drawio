          <mxGeometry x="175" y="155" width="8" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="m3" value="3. validate() 表单校验" style="endArrow=open;endSize=9;html=1;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=none;curved=0;verticalAlign=bottom;verticalLabelPosition=top;spacingTop=-4;" edge="1" parent="1">
