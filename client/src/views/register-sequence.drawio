        </mxCell>

        <!-- 9. 返回 null ← MySQL -->
        <mxCell id="m9" value="9. 返回 null（用户名可用）" style="endArrow=open;endSize=9;dashed=1;html=1;fontSize=9;fontFamily=Helvetica;fontColor=#555555;labelBackgroundColor=none;verticalAlign=bottom;verticalLabelPosition=top;spacingTop=-4;" edge="1" parent="1">
